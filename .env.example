# Supabase → Project Settings → Database → Connection string
# URL con pooler (puerto 6543) para la app en Vercel
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# URL directa (puerto 5432) para migraciones
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Número de WhatsApp con código de país, sin "+" ni espacios
NEXT_PUBLIC_WHATSAPP_NUMBER="5210000000000"
NEXT_PUBLIC_INSTAGRAM_USER="comidita"

# Acceso al panel /admin
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="una-contraseña-larga"
# Genera con: openssl rand -hex 32
ADMIN_SESSION_SECRET="cadena-aleatoria-de-64-caracteres"
